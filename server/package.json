{
  "name": "@pramana/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --no-warnings=ExperimentalWarning --watch --import tsx src/index.ts",
    "start": "node --no-warnings=ExperimentalWarning --import tsx src/index.ts",
    "seed": "node --no-warnings=ExperimentalWarning --import tsx src/seed/index.ts",
    "reset": "node --no-warnings=ExperimentalWarning --import tsx src/seed/index.ts --reset",
    "test": "node --no-warnings=ExperimentalWarning --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.0.4",
    "fastify": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.15.2",
    "viem": "^2.56.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/pdfkit": "^0.13.9",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
